# Envio do formulário de contato por SMTP (rota /api/contato).
# Configure as mesmas variáveis na Vercel: Settings > Environment Variables (Production e Preview).

# --- Opção A: Resend (resend.com) -------------------------------------------
# Exige um domínio verificado no Resend (registros DNS SPF/DKIM).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxx          # API key (permissão "Sending access")
# SMTP_FROM=site@<domínio verificado>    # ex.: site@futurorocha.com.br
# CONTACT_TO=contato@futurorocha.com.br

# --- Opção B: Google Workspace ---------------------------------------------
# SMTP_USER é a conta que envia; SMTP_PASS é a "senha de app" de 16 caracteres
# (myaccount.google.com > Segurança > Verificação em duas etapas > Senhas de app).
SMTP_USER=
SMTP_PASS=
CONTACT_TO=contato@futurorocha.com.br
# SMTP_FROM=        # opcional (padrão = SMTP_USER)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
